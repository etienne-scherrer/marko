{
    "name": "marko/broadcasting",
    "description": "Realtime broadcasting contracts and channel authorization for Marko Framework",
    "type": "marko-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "marko/authentication": "self.version",
        "marko/core": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Marko\\Broadcasting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marko\\Broadcasting\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
