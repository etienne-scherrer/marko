{
    "name": "marko/clock",
    "description": "PSR-20 system clock for Marko Framework",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "marko/core": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Marko\\Clock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marko\\Clock\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
